<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>{{ cgi_launchd_service | e }}</string>
    <!-- Use the logged-in user's Aqua session for macOS speech services. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
      <string>{{ cgi_python_binary | e }}</string>
      <string>-m</string>
      <string>http.server</string>
      <string>--cgi</string>
      <string>--bind</string>
      <string>127.0.0.1</string>
      <string>{{ cgi_port }}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{ cgi_dir | e }}</string>
    <key>StandardErrorPath</key>
    <string>{{ cgi_log_file | e }}</string>
    <key>StandardOutPath</key>
    <string>{{ cgi_log_file | e }}</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>{{ cgi_user_home | e }}</string>
      <key>PATH</key>
      <string>/opt/local/bin:/opt/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
