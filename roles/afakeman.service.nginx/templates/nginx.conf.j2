user  nobody;
worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;

    keepalive_timeout  65;

    gzip  on;

    geo $is_remote {
        default      "remote";
        192.168.65.0/24 "local";
    }

    include conf.d/*;
}
